{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "che-luogo-e",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-04",
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": true, "html_handling": "auto-trailing-slash", "not_found_handling": "none" },
  "vars": { "DATA_PROVIDER": "istat" }
  // D1, KV and R2 are intentionally not provisioned in phase 1.
  // Add real bindings after resource creation; see docs/ARCHITECTURE.md.
}
