{
  "name": "che-luogo-e",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 4173",
    "build": "tsc --noEmit && vite build && node scripts/prerender.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm test && npm run build",
    "worker:dev": "wrangler dev",
    "worker:check": "wrangler deploy --dry-run"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.3",
    "maplibre-gl": "^5.7.3",
    "lucide-react": "^0.544.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "vite": "^7.1.9",
    "typescript": "^5.9.3",
    "tsx": "^4.20.6",
    "wrangler": "^4.40.0"
  }
}
